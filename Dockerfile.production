# Floor for the system trust store. 20260909-r3 distrusts the compromised
# eMudhra intermediates (https://emudhra.we-have-a-problem.com). apk fails the
# build if it cannot satisfy the floor, and changing it invalidates cached layers.
ARG MIN_CA_CERTIFICATES_BUNDLE_VERSION=20260909-r3

# Base image with latest-dev tag digest
FROM cgr.dev/chainguard/rust:latest-dev@sha256:a3f989c28db9b8439e5c319441345ad3407cd468cda371285829cc357bd2430d AS base

WORKDIR /usr/app

USER root
RUN apk update && apk add openssl-dev

COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo install --root /usr/app --path . --profile release --locked

# Wolfi image with latest tag digest
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:81211e15a86ea1d5357f284482af45730c51de45eaf10ad9ce205d6bfc2df323

ARG version=3.12
# Node 24 LTS floor. 24.22.1 rejects chains through the compromised eMudhra
# intermediates (nodejs/node#66871) and ships NSS 3.131.1 roots.
ARG MIN_NODE_VERSION=24.22.1
ARG MIN_CA_CERTIFICATES_BUNDLE_VERSION

# libssl3/libcrypto3: the binary links OpenSSL 3, while wolfi-base now ships OpenSSL 4.
RUN apk add "ca-certificates-bundle>=${MIN_CA_CERTIFICATES_BUNDLE_VERSION}" bash python-${version} py${version}-pip "nodejs-24>=${MIN_NODE_VERSION}" jq libssl3 libcrypto3

# removes apk and unneeded wolfi-base tools.
RUN apk del wolfi-base apk-tools

WORKDIR /app
COPY --from=base --chown=nonroot:nonroot /usr/app/bin/openzeppelin-monitor /app/openzeppelin-monitor

ENV METRICS_PORT=8081

EXPOSE ${METRICS_PORT}/tcp

# starting up
ENTRYPOINT ["/app/openzeppelin-monitor"]
